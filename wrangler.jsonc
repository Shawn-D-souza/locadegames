{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker: matchmaking routes, the usage cron, and the RegionServer Durable Object.
  "name": "locade-server",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "REGION_SERVER", "class_name": "RegionServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegionServer"] }],
  "kv_namespaces": [
    // Created with `npx wrangler kv namespace create USAGE` (see docs/SETUP.md). Not a secret.
    { "binding": "USAGE", "id": "256ce48eccf14ec4b7d3ca4777f06e7c" }
  ],
  // Free-tier usage check every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // Comma-separated. "*" matches one subdomain label (Pages preview deployments).
    "ALLOWED_ORIGINS": "https://locadegames.pages.dev,https://*.locadegames.pages.dev"
  }
}
